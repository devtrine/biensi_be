generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH & USER MANAGEMENT 
// ==========================================
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  users User[]

  @@map("roles")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(100)
  name        String    @db.VarChar(100)
  password    String
  roleId      Int?       @map("role_id")
  
  // Tambahan dari Mockup Settings
  phoneNumber String?   @map("phone_number") @db.VarChar(50)
  photoUrl    String?   @map("photo_url")
  
  // Tambahan dari Mockup User Management
  lastLogin   DateTime? @map("last_login") @db.Timestamp(6)
  
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  role Role? @relation(fields: [roleId], references: [id])

  @@map("users")
}

// ==========================================
// MASTER ORGANIZATION (Dioptimasi ke Integer)
// ==========================================
model Division {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(100)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  departments       Department[]
  employees         Employee[]
  monthlySnapshots  EmployeeMonthlySnapshot[]
  movements         EmployeeMovement[]
  recruitmentReqs   RecruitmentRequest[]
  disciplinaryCases DisciplinaryCase[]

  @@map("divisions")
}

model Department {
  id         Int       @id @default(autoincrement())
  divisionId Int       @map("division_id")
  code       String    @unique @db.VarChar(50)
  name       String    @db.VarChar(100)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  division          Division                  @relation(fields: [divisionId], references: [id])
  units             Unit[]
  employees         Employee[]
  monthlySnapshots  EmployeeMonthlySnapshot[]
  movements         EmployeeMovement[]
  recruitmentReqs   RecruitmentRequest[]
  disciplinaryCases DisciplinaryCase[]

  @@map("departments")
}

model Position {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(50)
  name          String    @db.VarChar(100)
  employeeLevel String?   @map("employee_level") @db.VarChar(50)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  employees        Employee[]
  monthlySnapshots EmployeeMonthlySnapshot[]
  recruitmentReqs  RecruitmentRequest[]
  kpiPositions     KpiPosition[]

  @@map("positions")
}

model Unit {
  id           Int       @id @default(autoincrement())
  departmentId Int       @map("department_id")
  code         String    @unique @db.VarChar(50)
  name         String    @db.VarChar(100)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@map("units")
}

// ==========================================
// MASTER STORE (Dioptimasi ke Integer)
// ==========================================
model Store {
  id        Int       @id @default(autoincrement())
  storeCode String    @unique @map("store_code") @db.VarChar(50)
  storeName String    @map("store_name") @db.VarChar(150)
  storeType String?   @map("store_type") @db.VarChar(50)
  region    String?   @db.VarChar(50)
  area      String?   @db.VarChar(100)
  asstHead  String?   @map("asst_head") @db.VarChar(150)
  isActive  Boolean?  @default(true) @map("is_active")
  openedAt  DateTime? @map("opened_at") @db.Date
  closedAt  DateTime? @map("closed_at") @db.Date
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  compliances       StoreCompliance[]
  employees         Employee[]
  monthlySnapshots  EmployeeMonthlySnapshot[]
  movements         EmployeeMovement[]
  salesMonthly      SalesMonthly[]
  recruitmentReqs   RecruitmentRequest[]
  disciplinaryCases DisciplinaryCase[]
  fraudCases        FraudCase[]
  irCases           IndustrialRelationCase[]

  @@map("stores")
}

model StoreCompliance {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      Int       @map("store_id")
  documentType String    @map("document_type") @db.VarChar(50)
  status       String?   @db.VarChar(50) // Tambahan: PATUH, KADALUARSA, dll
  validFrom    DateTime? @map("valid_from") @db.Date  // JADIKAN OPSIONAL (?)
  validUntil   DateTime? @map("valid_until") @db.Date // JADIKAN OPSIONAL (?)
  description  String?   @db.Text // Tambahan untuk menyimpan "Deskripsi Instrumen" seperti di UI
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  store Store @relation(fields: [storeId], references: [id])
  @@map("store_compliances")
}

// ==========================================
// MASTER EMPLOYEE & MOVEMENTS (UUID)
// ==========================================
model Employee {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeNo          String    @unique @map("employee_no") @db.VarChar(50)
  fullName            String    @map("full_name") @db.VarChar(200)
  gender              String?   @db.VarChar(20)
  birthDate           DateTime? @map("birth_date") @db.Date
  educationLevel      String?   @map("education_level") @db.VarChar(50)
  divisionId          Int?      @map("division_id")
  departmentId        Int?      @map("department_id")
  UnitId              Int?      @map("unit_id")
  positionId          Int?      @map("position_id")
  storeId             Int?      @map("store_id")
  employmentType      String?   @map("employment_type") @db.VarChar(30)
  joinDate            DateTime  @map("join_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String?   @default("ACTIVE") @db.VarChar(30)
  bpjsKetenagakerjaan Boolean?  @default(false) @map("bpjs_ketenagakerjaan")
  bpjsKesehatan       Boolean?  @default(false) @map("bpjs_kesehatan")
  
  // ---> PERUBAHAN: TAMBAHAN BASE SALARY <---
  baseSalary          Decimal?  @map("base_salary") @db.Decimal(18, 2)
  
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  division   Division?   @relation(fields: [divisionId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  unit       Unit?       @relation(fields: [UnitId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])
  store      Store?      @relation(fields: [storeId], references: [id])

  monthlySnapshots  EmployeeMonthlySnapshot[]
  movements         EmployeeMovement[]
  
  // ---> PERUBAHAN: HAPUS relasi attendanceRecords lama <---
  
  recruitmentHires  RecruitmentHire[]
  disciplinaryCases DisciplinaryCase[]
  fraudCases        FraudCase[]
  irCases           IndustrialRelationCase[]
  kpiPositions      KpiPosition[]

  @@index([storeId], map: "idx_employee_store")
  @@index([departmentId], map: "idx_employee_department")
  @@index([UnitId], map: "idx_employee_unit")
  @@map("employees")
}

model EmployeeMovement {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  
  // Tipe pergerakan: 'VOLUNTARY' atau 'INVOLUNTARY'
  movementType        String    @map("movement_type") @db.VarChar(50) 
  
  movementDate        DateTime  @map("movement_date") @db.Date
  
  // Kategori alasan: 'RESIGN SOP', 'PHK', dll
  reasonCategory      String?   @map("reason_category") @db.VarChar(100) 
  
  reasonDetail        String?   @map("reason_detail") @db.Text 
  
  // Kolom baru untuk memenuhi Mockup Dashboard HR
  clearanceStatus     String?   @map("clearance_status") @db.VarChar(50)
  backfillStatus      String?   @map("backfill_status") @db.VarChar(100)
  retentionAction     String?   @map("retention_action") @db.VarChar(255)

  divisionId          Int?      @map("division_id")
  departmentId        Int?      @map("department_id")
  storeId             Int?      @map("store_id")
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  employee   Employee    @relation(fields: [employeeId], references: [id])
  division   Division?   @relation(fields: [divisionId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  store      Store?      @relation(fields: [storeId], references: [id])

  @@map("employee_movements")
}

// ==========================================
// REPORTING & SNAPSHOTS (UUID)
// ==========================================
model ReportingPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  year        Int      @db.SmallInt
  month       Int      @db.SmallInt
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  employeeSnaps   EmployeeMonthlySnapshot[]
  salesMonthly    SalesMonthly[]
  kpiPositions    KpiPosition[]
  
  // ---> PERUBAHAN: HAPUS relasi labourCosts & attendanceRecords lama, TAMBAH agregat <---
  attendanceAggregate AttendanceAggregateMonthly[]
  spAggregateMonthly  SpAggregateMonthly[]

  @@unique([year, month])
  @@map("reporting_periods")
}

model EmployeeMonthlySnapshot {
  id                  String    @id @default(uuid()) @db.Uuid
  periodId            String    @map("period_id") @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  divisionId          Int?      @map("division_id")
  departmentId        Int?      @map("department_id")
  positionId          Int?      @map("position_id")
  storeId             Int?      @map("store_id")
  employeeLevel       String?   @map("employee_level") @db.VarChar(50)
  employmentType      String?   @map("employment_type") @db.VarChar(30)
  ageYears            Decimal?  @map("age_years") @db.Decimal(5, 2)
  tenureYears         Decimal?  @map("tenure_years") @db.Decimal(5, 2)
  employmentStatus    String?   @map("employment_status") @db.VarChar(30)
  bpjsKetenagakerjaan Boolean?  @map("bpjs_ketenagakerjaan")
  bpjsKesehatan       Boolean?  @map("bpjs_kesehatan")
  
  // ---> PERUBAHAN: SPLIT LABOUR COST <---
  budgetLabourCost    Decimal?  @map("budget_labour_cost") @db.Decimal(18, 2)
  actualLabourCost    Decimal?  @map("actual_labour_cost") @db.Decimal(18, 2)
  
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  period     ReportingPeriod @relation(fields: [periodId], references: [id])
  employee   Employee        @relation(fields: [employeeId], references: [id])
  division   Division?       @relation(fields: [divisionId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id])
  position   Position?       @relation(fields: [positionId], references: [id])
  store      Store?          @relation(fields: [storeId], references: [id])

  @@unique([periodId, employeeId])
  @@index([periodId], map: "idx_snapshot_period")
  @@map("employee_monthly_snapshots")
}

// ---> PERUBAHAN: TAMBAH MODEL BARU INI <---
model AttendanceAggregateMonthly {
  id               String   @id @default(uuid()) @db.Uuid
  periodId         String   @map("period_id") @db.Uuid
  totalEmployees   Int      @map("total_employees")
  scope            String?  @map("scope") @db.VarChar(50)
  sickCount        Int      @default(0) @map("sick_count")
  permissionCount  Int      @default(0) @map("permission_count")
  annualLeaveCount Int      @default(0) @map("annual_leave_count")
  absentCount      Int      @default(0) @map("absent_count")
  workingDays      Int?     @map("working_days")
  attendanceRate   Decimal? @map("attendance_rate") @db.Decimal(5, 2)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  period ReportingPeriod @relation(fields: [periodId], references: [id])
  @@unique([periodId, scope])
  @@map("attendance_aggregate_monthly")
}

model SalesMonthly {
  id           String    @id @default(uuid()) @db.Uuid
  periodId     String    @map("period_id") @db.Uuid
  storeId      Int       @map("store_id")
  salesQty     Decimal?  @default(0) @map("sales_qty") @db.Decimal(18, 2)
  netSales     Decimal?  @default(0) @map("net_sales") @db.Decimal(18, 2)
  targetSales  Decimal?  @map("target_sales") @db.Decimal(18, 2)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  period ReportingPeriod @relation(fields: [periodId], references: [id])
  store  Store           @relation(fields: [storeId], references: [id])

  @@unique([periodId, storeId])
  @@map("sales_monthly")
}

// ==========================================
// RECRUITMENT & KPI (UUID)
// ==========================================
model RecruitmentRequest {
  id                 String    @id @default(uuid()) @db.Uuid
  requestCode        String    @unique @map("request_code") @db.VarChar(50)
  requestedAt        DateTime? @map("requested_at") @db.Date
  divisionId         Int?      @map("division_id")
  departmentId       Int?      @map("department_id")
  positionId         Int?      @map("position_id")
  storeId            Int?      @map("store_id")
  requestedHeadcount Int?      @default(0) @map("requested_headcount")
  filledHeadcount    Int?      @default(0) @map("filled_headcount")
  status             String?   @db.VarChar(30)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  division   Division?         @relation(fields: [divisionId], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])
  position   Position?         @relation(fields: [positionId], references: [id])
  store      Store?            @relation(fields: [storeId], references: [id])
  hires      RecruitmentHire[]

  @@map("recruitment_requests")
}

model RecruitmentHire {
  id                   String    @id @default(uuid()) @db.Uuid
  recruitmentRequestId String    @map("recruitment_request_id") @db.Uuid
  employeeId           String?   @map("employee_id") @db.Uuid
  appliedAt            DateTime? @map("applied_at") @db.Date
  hiredAt              DateTime? @map("hired_at") @db.Date
  recruitmentCost      Decimal?  @map("recruitment_cost") @db.Decimal(18, 2)
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  request  RecruitmentRequest @relation(fields: [recruitmentRequestId], references: [id])
  employee Employee?          @relation(fields: [employeeId], references: [id])

  @@map("recruitment_hires")
}

model KpiPosition {
  id             String    @id @default(uuid()) @db.Uuid
  periodId       String    @map("period_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  positionId     Int?      @map("position_id")
  kpiStatus      String?   @map("kpi_status") @db.VarChar(50)
  completionDate DateTime? @map("completion_date") @db.Date
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  period   ReportingPeriod @relation(fields: [periodId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id])
  position Position?       @relation(fields: [positionId], references: [id])

  @@map("kpi_positions")
}

// ==========================================
// RISK, FRAUD & IR (UUID)
// ==========================================
model DisciplinaryCase {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  referenceNo    String?   @map("reference_no") @db.VarChar(100)
  disciplineType String?   @map("discipline_type") @db.VarChar(50)
  category       String?   @db.VarChar(100)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  remark         String?   @db.Text
  status         String?   @default("AKTIF") @db.VarChar(50)
  divisionId     Int?      @map("division_id")
  departmentId   Int?      @map("department_id")
  storeId        Int?      @map("store_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  employee   Employee    @relation(fields: [employeeId], references: [id])
  division   Division?   @relation(fields: [divisionId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  store      Store?      @relation(fields: [storeId], references: [id])
  fraudCases FraudCase[]

  @@index([employeeId], map: "idx_discipline_employee")
  @@map("disciplinary_cases")
}

model FraudCase {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String?   @map("employee_id") @db.Uuid
  storeId        Int?      @map("store_id")
  caseDate       DateTime? @map("case_date") @db.Date
  auditDate      DateTime? @map("audit_date") @db.Date
  disciplineId   String?   @map("discipline_id") @db.Uuid
  fraudCategory  String?   @map("fraud_category") @db.VarChar(100)
  remark         String?   @db.Text
  status         String?   @default("OPEN") @db.VarChar(50)
  discrepancyQty Decimal?  @map("discrepancy_qty") @db.Decimal(18, 2)
  bakbAmount     Decimal?  @map("bakb_amount") @db.Decimal(18, 2)
  salesTarget    Decimal?  @map("sales_target") @db.Decimal(18, 2)
  salesActual    Decimal?  @map("sales_actual") @db.Decimal(18, 2)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  employee   Employee?         @relation(fields: [employeeId], references: [id])
  store      Store?            @relation(fields: [storeId], references: [id])
  discipline DisciplinaryCase? @relation(fields: [disciplineId], references: [id])

  @@map("fraud_cases")
}

model IndustrialRelationCase {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String?   @map("employee_id") @db.Uuid
  storeId      Int?      @map("store_id")
  caseCategory String?   @map("case_category") @db.VarChar(100)
  status       String?   @db.VarChar(50)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  description  String?   @db.Text
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  employee Employee? @relation(fields: [employeeId], references: [id])
  store    Store?    @relation(fields: [storeId], references: [id])

  @@index([status], map: "idx_ir_case_status")
  @@map("industrial_relation_cases")
}

model SpAggregateMonthly {
  id                 String          @id @default(uuid()) @db.Uuid
  periodId           String          @map("period_id") @db.Uuid
  scope              String          @default("STORE") @db.VarChar(20)

  totalEmployees     Int             @default(0) @map("total_employees")
  tataTertibCount    Int             @default(0) @map("tata_tertib_count")     // Kategori SP: Tata Tertib
  nonTataTertibCount Int             @default(0) @map("non_tata_tertib_count") // Kategori SP: Non Tata Tertib
  totalSpIssued      Int             @default(0) @map("total_sp_issued")       // Metrik #27: Jumlah total SP yg diterbitkan
  breakdown          Json?           @map("breakdown")                         // Rincian SP1-3, Regional, Toko, Jabatan

  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  period             ReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scope])
  @@map("sp_aggregate_monthly")
}
// ==========================================
// IMPORT PIPELINE (Staging - Tetap Pakai UUID/BigInt)
// ==========================================
model ImportBatch {
  id          String    @id @default(uuid()) @db.Uuid
  fileName    String    @map("file_name") @db.VarChar(255)
  sourceType  String?   @map("source_type") @db.VarChar(50)
  status      String?   @db.VarChar(30)
  totalRows   Int?      @default(0) @map("total_rows")
  successRows Int?      @default(0) @map("successRows")
  failedRows  Int?      @default(0) @map("failed_rows")
  startedAt   DateTime? @map("started_at") @db.Timestamp(6)
  completedAt DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  stagingData StagingEmployeeImport[]

  @@map("import_batches")
}

model StagingEmployeeImport {
  id               BigInt    @id @default(autoincrement())
  importBatchId    String?   @map("import_batch_id") @db.Uuid
  employeeNo       String?   @map("employee_no") @db.Text
  fullName         String?   @map("full_name") @db.Text
  positionName     String?   @map("position_name") @db.Text
  storeName        String?   @map("store_name") @db.Text
  joinDate         String?   @map("join_date") @db.Text
  rowNumber        Int?      @map("row_number")
  validationStatus String?   @map("validation_status") @db.VarChar(30)
  validationError  String?   @map("validation_error") @db.Text
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  batch ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@map("staging_employee_import")
}
