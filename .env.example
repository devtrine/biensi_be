# Port aplikasi backend Express
PORT=5000

# Environment mode (development / production)
NODE_ENV=production

# Database URL PostgreSQL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://biensi_user:password_rahasia_anda@localhost:5432/biensi_db?schema=public"

# Rahasia JWT Token (Gunakan string acak panjang, misal hasil 'openssl rand -hex 32')
JWT_SECRET="ganti_dengan_random_secret_panjang_dan_aman_untuk_production"

# CORS Origin Whitelist
# Gunakan '*' untuk mengizinkan semua domain (default dev atau saat memakai Nginx reverse proxy)
# Atau tentukan domain spesifik frontend (pisahkan koma jika lebih dari satu):
# CORS_ORIGIN="https://biensi.example.com,https://admin.example.com"
CORS_ORIGIN="*"
